{
  "$schema": "https://design-tokens.org/tokens.schema.json",
  "meta": {
    "brand": "Apetrechos Calçados",
    "version": "1.0.0",
    "updated": "2026-07-29",
    "tagline": "Conforto e estilo em um só lugar",
    "description": "Design tokens da marca Apetrechos Calçados. Camadas: primitivo → semântico. Estilo: minimalismo editorial com vidro pontual."
  },

  "color": {
    "primitive": {
      "brand": {
        "50":  { "value": "#FDF2F8" },
        "600": { "value": "#DB2777" },
        "700": { "value": "#BE185D", "comment": "Rosé — cor primária da marca" },
        "900": { "value": "#7A0F3C" }
      },
      "gold": {
        "500": { "value": "#C08A2E" },
        "700": { "value": "#A16207", "comment": "Ouro editorial — acento secundário" }
      },
      "ink": {
        "900": { "value": "#0B0B0F", "comment": "Tinta — quase-preto quente da marca" },
        "800": { "value": "#16161C" },
        "700": { "value": "#2A2A33" },
        "500": { "value": "#5C5C68" },
        "400": { "value": "#6C6C78", "comment": "Menor cinza legível: 5.2:1 sobre branco" },
        "200": { "value": "#D9D7DA" },
        "100": { "value": "#EDEBEC" }
      },
      "paper": {
        "white":   { "value": "#FFFFFF" },
        "warm":    { "value": "#FAF9F8" },
        "warm-2":  { "value": "#F3F1EF" }
      },
      "signal": {
        "success": { "value": "#15803D" },
        "danger":  { "value": "#C02626" },
        "success-bg": { "value": "#EAF6EE" }
      }
    },

    "semantic": {
      "light": {
        "bg":            { "value": "{color.primitive.paper.white}" },
        "surface":       { "value": "{color.primitive.paper.warm}" },
        "surface-2":     { "value": "{color.primitive.paper.warm-2}" },
        "surface-glass": { "value": "rgba(255,255,255,0.72)" },
        "fg":            { "value": "{color.primitive.ink.900}" },
        "fg-muted":      { "value": "{color.primitive.ink.500}" },
        "fg-subtle":     { "value": "{color.primitive.ink.400}" },
        "border":        { "value": "#E7E4E2" },
        "border-strong": { "value": "#D3CFCC" },
        "primary":       { "value": "{color.primitive.brand.700}" },
        "primary-hover": { "value": "{color.primitive.brand.900}" },
        "on-primary":    { "value": "#FFFFFF" },
        "accent":        { "value": "{color.primitive.gold.700}" },
        "ring":          { "value": "{color.primitive.brand.700}" }
      },
      "dark": {
        "bg":            { "value": "#0B0B0F" },
        "surface":       { "value": "#131319" },
        "surface-2":     { "value": "#1B1B23" },
        "surface-glass": { "value": "rgba(19,19,25,0.76)" },
        "fg":            { "value": "#F6F5F7" },
        "fg-muted":      { "value": "#A7A5AE" },
        "fg-subtle":     { "value": "#85838C" },
        "border":        { "value": "#292930" },
        "border-strong": { "value": "#3A3A44" },
        "primary":       { "value": "#F472B6", "comment": "Rosé dessaturado para o fundo escuro (não é inversão)" },
        "primary-hover": { "value": "#F9A8D4" },
        "on-primary":    { "value": "#2A0716" },
        "accent":        { "value": "#E3B341" },
        "ring":          { "value": "#F472B6" }
      }
    },

    "product-palette": {
      "comment": "Cores de produto usadas nas fichas e swatches do catálogo.",
      "preto":       { "value": "#1A1A1F" },
      "off-white":   { "value": "#F2EFE9" },
      "caramelo":    { "value": "#A9662F" },
      "nude":        { "value": "#D8B49C" },
      "vinho":       { "value": "#6B1D33" },
      "dourado":     { "value": "#B58A3C" },
      "bege":        { "value": "#CBB79C" },
      "marrom":      { "value": "#4E342A" },
      "rosa-seco":   { "value": "#C48A9A" },
      "prata":       { "value": "#B9BCC2" },
      "verde-musgo": { "value": "#4A5A44" },
      "jeans":       { "value": "#5C6E8A" }
    }
  },

  "typography": {
    "family": {
      "display": { "value": "'Playfair Display', 'Times New Roman', serif", "comment": "Títulos, números de destaque" },
      "body":    { "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "comment": "Corpo, UI, rótulos" }
    },
    "weight": {
      "regular":  { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 }
    },
    "scale": {
      "comment": "rem, base 16px. No mobile (<900px) o base sobe para 1rem para evitar auto-zoom do iOS.",
      "xs":   { "value": "0.75rem" },
      "sm":   { "value": "0.8125rem" },
      "base": { "value": "0.9375rem" },
      "md":   { "value": "1rem" },
      "lg":   { "value": "1.25rem" },
      "xl":   { "value": "1.5rem" },
      "2xl":  { "value": "2rem" },
      "3xl":  { "value": "2.75rem" },
      "4xl":  { "value": "3.75rem" }
    },
    "leading": {
      "tight":  { "value": 1.15, "comment": "Títulos" },
      "normal": { "value": 1.6, "comment": "Corpo" }
    },
    "tracking": {
      "heading": { "value": "-0.01em" },
      "eyebrow": { "value": "0.22em", "comment": "Rótulos em caixa alta" },
      "label":   { "value": "0.14em" }
    }
  },

  "space": {
    "comment": "Escala 4/8. Nome = múltiplo.",
    "1": { "value": "4px" },
    "2": { "value": "8px" },
    "3": { "value": "12px" },
    "4": { "value": "16px" },
    "5": { "value": "24px" },
    "6": { "value": "32px" },
    "7": { "value": "48px" },
    "8": { "value": "64px" },
    "9": { "value": "96px" }
  },

  "radius": {
    "sm":   { "value": "6px" },
    "md":   { "value": "10px" },
    "lg":   { "value": "16px" },
    "xl":   { "value": "24px" },
    "full": { "value": "999px" }
  },

  "elevation": {
    "comment": "Sombras baseadas em rgba(11,11,15,*). No tema escuro trocam para rgba(0,0,0,*).",
    "1": { "value": "0 1px 2px rgba(11,11,15,.05)" },
    "2": { "value": "0 2px 8px rgba(11,11,15,.06), 0 1px 2px rgba(11,11,15,.04)" },
    "3": { "value": "0 8px 28px rgba(11,11,15,.10), 0 2px 6px rgba(11,11,15,.05)" },
    "4": { "value": "0 24px 60px rgba(11,11,15,.18)" }
  },

  "motion": {
    "duration": {
      "fast": { "value": "160ms" },
      "base": { "value": "240ms" },
      "slow": { "value": "380ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(.32,.72,0,1)", "comment": "Curva padrão da marca" },
      "out":      { "value": "cubic-bezier(.16,1,.3,1)" }
    },
    "comment": "Respeitar prefers-reduced-motion: reduzir a ~0.01ms."
  },

  "layout": {
    "container": { "value": "1360px" },
    "breakpoints": {
      "sm": { "value": "640px" },
      "md": { "value": "768px" },
      "lg": { "value": "1024px" },
      "xl": { "value": "1280px" }
    },
    "z-index": {
      "base": 1, "sticky": 40, "overlay": 70, "drawer": 80, "toast": 100
    }
  },

  "component": {
    "button": {
      "min-height":    { "value": "44px" },
      "min-height-lg": { "value": "54px" },
      "radius":        { "value": "{radius.full}" },
      "font-size":     { "value": "{typography.scale.sm}" },
      "font-weight":   { "value": 600 }
    },
    "touch-target-min": { "value": "44px", "comment": "Mínimo em todos os controles primários" },
    "card": {
      "media-ratio": { "value": "5 / 6" },
      "radius":      { "value": "{radius.lg}" }
    },
    "icon": {
      "size-sm": { "value": "16px" },
      "size":    { "value": "20px" },
      "size-lg": { "value": "24px" },
      "stroke":  { "value": "1.6", "comment": "Família única, traço 1.6, viewBox 24 (padrão Lucide)" }
    }
  }
}
